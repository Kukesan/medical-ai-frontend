# Backend origin, fixed at build time. Production builds fail unless this is https (localhost excepted).
VITE_API_ORIGIN=http://localhost:8000
# Public production origin (https, no trailing slash). Drives canonical URLs, Open Graph, JSON-LD and sitemap.xml.
# On Railway use: VITE_SITE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}} (falls back to RAILWAY_PUBLIC_DOMAIN when unset).
VITE_SITE_URL=

# Runtime (Caddy), not build time: origins the browser may connect to, for the Content-Security-Policy.
# CSP_CONNECT_SRC=https://api.example.com https://your-bucket.s3.us-east-1.amazonaws.com
